<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>

    <style>
      @font-face {
        font-family: 'iranyekan';
        font-style: normal;
        font-weight: 300;
        src: url('/fonts/woff2/Estedad-Regular.woff2') format('woff2');
      }

      /* ------------------------------------      MEDIUM      ------------------------------------ */
      @font-face {
        font-family: 'iranyekan';
        font-style: normal;
        font-weight: 500;
        src: url('/fonts/woff2/Estedad-Medium.woff2') format('woff2');
      }

      /* ------------------------------------       BOLD       ------------------------------------ */
      @font-face {
        font-family: 'iranyekan';
        font-style: normal;
        font-weight: 700;
        src: url('/fonts/woff2/Estedad-ExtraBold.woff2') format('woff2');
      }
      body {
        background-color: #f1f1f1;
        color: white;
        font-family: iranyekan, Verdana, Geneva, Tahoma, sans-serif;
        width: 100%;
        margin: auto;
      }

      .container {
        width: 80%;
        margin: auto;
        margin-top: 100px;
        text-align: center;
        max-width: 400px;
        border-radius: 0 0 20px 20px;
        box-shadow: rgba(17, 12, 46, 0.15) 0px 48px 100px 0px;
      }

      .box-1 {
        background-color: #ef4444;
        /* padding: 20px; */
        height: 300px;
        font-size: 20px;
        border-radius: 20px 20px 0 0;
      }

      .box-2 {
        background-color: white;
        padding: 40px 12px;
        color: black;
        border-radius: 0 0 20px 20px;
        /* min-height: 200px; */
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
      }
      #check-icon svg {
        margin: 40px 0 0px 0;
      }

      h4 {
        font-weight: 400;
        font-size: 13px;
      }
      .title {
        font-weight: 700;
        font-size: 20px;
        margin-top: 10px;
      }

      a {
        background-color: #ef4444;
        color: white;
        font-size: 14px;
        margin: 30px;
        border: 0;
        width: 150px;
        /* height: 50px; */
        border-radius: 50px;
        padding: 8px 12px;
        text-decoration: none;
      }

      button:hover {
        background-color: rgb(219, 70, 44);
        transition: 0.3s;
        cursor: pointer;
      }

      .message-box {
        text-align: right;
      }

      hr {
        height: 1.5px;
        border-width: 0;
        color: rgb(167, 167, 167);
        background-color: rgb(167, 167, 167);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="box-1">
        <div id="check-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="70"
            height="70"
            fill="currentColor"
            class="bi bi-x-square-fill"
            viewBox="0 0 16 16"
          >
            <path
              fill-rule="evenodd"
              d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2zm3.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"
            />
          </svg>
          <div class="title"><%= status %></div>
          <h4><%= message %></h4>
        </div>
      </div>

      <div class="box-2">
        <a href="<%= redirect_url %>?status=failed"><%= redirectButtonTitle %></a>
      </div>
    </div>
  </body>
</html>
