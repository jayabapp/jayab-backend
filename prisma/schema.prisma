// ------------------------------ NOTIFICATION ------------------------------ //
model Notification {
  id      Int       @id() @default(autoincrement())
  user_id Int?      @db.Integer
  role    String?
  title   String    @db.Text
  body    String    @db.Text
  topic   String?   @db.VarChar()
  data    Json?     @db.JsonB
  seen_at DateTime?

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  @@map("notifications")
}

