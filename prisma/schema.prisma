model OptionsOnProperty {
  property_id Int
  option_id   Int
  assigned_at DateTime @default(now()) @db.Timestamp(6)

  property Property       @relation(fields: [property_id], references: [id])
  option   PropertyOption @relation(fields: [option_id], references: [id])

  @@id([property_id, option_id])
  @@map("options_on_property")
}

// ---------------------------- PROPERTY OPTIONS ---------------------------- //
model PropertyOption {
  id          Int       @id() @default(autoincrement())
  title       String    @db.VarChar
  description String?   @db.VarChar(256)
  group       String
  sort        Int?
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime? @db.Timestamp(6)

  // rent_requests OptionsOnRentRequest[]
  properties OptionsOnProperty[]
  // rent_request_options RentRequest[]

  @@map("property_options")
}

