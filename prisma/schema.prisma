// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views", "fullTextSearchPostgres"]
}

// generator dbml {
//   provider              = "prisma-dbml-generator"
//   includeRelationFields = false
//   outputName            = "b2c-erd.dbml"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Base {
  id Int @id() @default(autoincrement())

  @@map("generator_base")
}

model Otp {
  id            Int      @id() @default(autoincrement())
  mobile_number String   @unique() @db.VarChar(11)
  attempts      Int      @default(0) @db.SmallInt
  code          String
  sms_send_at   DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("otps")
}

// -------------------------------------------------------------------------- //
//                                    ADMIN                                   //
// -------------------------------------------------------------------------- //
model Admin {
  id            Int     @id() @default(autoincrement())
  username      String  @unique @db.VarChar(64)
  password      String  @db.VarChar
  full_name     String  @db.VarChar(64)
  mobile_number String  @unique @db.VarChar(11)
  role_id       Int     @db.SmallInt
  is_active     Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role              AccessControlRole @relation(fields: [role_id], references: [id])
  activities        AdminActivity[]
  content_questions ContentQuestion[]

  @@map("admins")
}

// --------------------------------- ACL --------------------------------- //
model AccessControlModule {
  id   Int    @id() @default(autoincrement())
  key  String @unique @db.VarChar(64)
  name String @db.VarChar(64)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  acl AccessControlList[]

  @@map("access_control_modules")
}

model AccessControlRole {
  id   Int     @id() @default(autoincrement())
  name String  @unique @db.VarChar(64)
  key  String? @unique
  tree String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  acl                      AccessControlList[]
  admin                    Admin[]
  notification_permissions AdminRoleNotificationPermission?

  @@map("access_control_roles")
}

model AccessControlList {
  id        Int     @id() @default(autoincrement())
  module_id Int
  role_id   Int
  c         Boolean @default(false)
  r         Boolean @default(false)
  u         Boolean @default(false)
  d         Boolean @default(false)
  v         Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  module AccessControlModule @relation(fields: [module_id], references: [id])
  role   AccessControlRole   @relation(fields: [role_id], references: [id])

  @@unique([module_id, role_id])
  @@map("access_control_list")
}

model AdminRoleNotificationPermission {
  id          Int     @id() @default(autoincrement())
  role_id     Int     @unique
  permissions String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role AccessControlRole? @relation(fields: [role_id], references: [id])

  @@map("admin_role_notification_permissions")
}

// --------------------------------- ACL END --------------------------------- //

// ----------------------------- ADMIN ACTIVITY ----------------------------- //
model AdminActivity {
  id Int @id() @default(autoincrement())

  // user agent info
  os          String? @db.VarChar(32)
  browser     String? @db.VarChar(32)
  browser_ver String? @db.VarChar(32)

  // req & res info
  ip_v4       String? @db.VarChar(16)
  admin_id    Int     @db.Integer
  module      String  @db.VarChar(32)
  path        String  @db.VarChar
  method      String  @db.VarChar(8)
  className   String  @db.VarChar(128)
  classMethod String  @db.VarChar(128)
  param       Json?
  query       Json?
  body        Json?
  result_id   Int?    @db.Integer
  status_code Int     @db.Integer

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  admin Admin @relation(fields: [admin_id], references: [id])

  @@map("admin_activities")
}

// ---------------------------------- ATTACHMENT ---------------------------------- //
model Attachment {
  id        Int     @id() @default(autoincrement())
  user_id   Int?
  admin_id  Int?
  user_role String?
  name      String  @db.VarChar
  meta      String? @db.VarChar
  thumbnail String?
  type      Int     @default(1) // 1 -> image, 2 -> video, 3 -> audio
  path      String
  bucket    String
  region    String?
  end_point String
  medium    String?
  alt       String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? @db.Timestamp(6)

  content_attachment          ContentAttachment[]
  content_categories          ContentCategory[]
  content_feature_image       Content[]            @relation(name: "featureImage")
  content_video               Content[]            @relation(name: "ContentVideo")
  content_question_image      ContentQuestion[]
  property                    Property[]           @relation("Property")
  property_temp               Property[]           @relation("Property_Temp")
  feature_image               Property[]           @relation("FeatureImage")
  property_video              Property[]           @relation("Video")
  banners                     Banner[]             @relation("Image")
  banner_image_sm             Banner[]             @relation("ImageSm")
  advisor_national_card_image Advisor?             @relation("NationalCard")
  advisor_document_image      Advisor?             @relation("DocumentImage")
  user_profile_image          User?
  owner_selfie_image          Owner?
  category_image              Category?
  submitted_form_items        SubmittedFormItems[]
  city                        City[]
  messenger_media             MessengerMessages[]
  property_auth_nc            PropertyAuthorize[]  @relation("PropertyAuthNcImage")
  property_auth_docs          PropertyAuthorize[]  @relation("PropertyAuthDocsImage")
  landing_page_image          LandingPage[]
  property_options            PropertyOption[]

  @@map("attachments")
}

// ----------------------------- CONTENT ------------------------------ //

model ContentCategory {
  id              Int     @id() @default(autoincrement())
  title           String  @db.VarChar
  slug            String  @unique
  key             String  @unique @db.VarChar(64)
  image_id        Int?    @db.Integer
  dynamic_fields  Json?   @db.JsonB
  parent_id       Int?
  description     String? @db.Text
  html            String? @db.Text
  show_in_sitemap Boolean @default(true)
  seo             Json?   @db.JsonB

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent    ContentCategory?  @relation("Parent", fields: [parent_id], references: [id])
  child     ContentCategory[] @relation("Parent")
  content   Content[]
  image     Attachment?       @relation(fields: [image_id], references: [id])
  questions ContentQuestion[]

  @@map("content_categories")
}

model Content {
  id               Int     @id() @default(autoincrement())
  title            String  @db.VarChar
  slug             String? @unique
  key              String? @db.VarChar(64)
  small_text       String?
  full_text        String?
  feature_image_id Int?
  is_active        Boolean @default(true)
  category_id      Int?    @db.Integer
  order            Int?    @db.Integer
  html             String? @db.Text
  view_count       Int     @default(0)
  link             String?
  video_id         Int?
  show_in_sitemap  Boolean @default(true)

  fields      Json?               @db.JsonB
  seo         Json?               @db.JsonB
  form_id     Int?
  attachments ContentAttachment[] //images

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category       ContentCategory?  @relation(fields: [category_id], references: [id], onDelete: SetNull)
  feature_image  Attachment?       @relation("featureImage", fields: [feature_image_id], references: [id], onDelete: SetNull)
  video          Attachment?       @relation("ContentVideo", fields: [video_id], references: [id], onDelete: SetNull)
  questions      ContentQuestion[]
  forms          FormBuilder[]
  submitted_form SubmittedForm[]
  landing_page   LandingPage[]

  @@map("contents")
}

model ContentAttachment {
  id            Int       @id() @default(autoincrement())
  content_id    Int
  attachment_id Int
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime? @db.Timestamp(6)

  attachment Attachment @relation(fields: [attachment_id], references: [id], onDelete: Cascade)
  content    Content    @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@map("content_attachments")
}

model ContentQuestion {
  id                  Int     @id() @default(autoincrement())
  content_id          Int?
  content_category_id Int?
  question            String  @db.Text
  answer              String? @db.Text
  image_id            Int?    @db.Integer
  admin_id            Int?    @db.Integer
  rate                Int?
  author_name         String?
  mobile_number       String?
  is_publish          Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  image            Attachment?      @relation(fields: [image_id], references: [id])
  content          Content?         @relation(fields: [content_id], references: [id], onDelete: Cascade)
  content_category ContentCategory? @relation(fields: [content_category_id], references: [id], onDelete: SetNull)
  admin            Admin?           @relation(fields: [admin_id], references: [id])

  @@map("content_questions")
}

// ---------------------------------- CITY ---------------------------------- //
model City {
  id         Int     @id() @default(autoincrement())
  title      String  @db.VarChar
  parent_id  Int?
  sort_order Int?
  slug       String?
  slug_fa    String?
  tel_prefix String?
  image_id   Int?
  parent     City?   @relation("Parent", fields: [parent_id], references: [id])
  child      City[]  @relation("Parent")

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? @db.Timestamp(6)

  image             Attachment? @relation(fields: [image_id], references: [id], onDelete: SetNull)
  advisors          Advisor[] //@relation(fields: [advisorId], references: [id])
  // advisorId         Int?
  property_city     Property[]  @relation("PropertyCity")
  Property_province Property[]  @relation("PropertyProvince")
  Property_region   Property[]  @relation("PropertyRegion")

  @@index([id, sort_order, slug])
  @@index([title])
  @@index([parent_id])
  @@map("cities")
}

// --------------------------------- SETTINGS --------------------------------- //
model Setting {
  id         Int    @id() @default(autoincrement())
  title      String
  key        String
  value      String
  max        Int?
  min        Int?
  data_type  String @default("NUMBER")
  sort_order Int?

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  @@unique([key])
  @@map("settings")
}

// --------------------------------- BANNER --------------------------------- //
model Banner {
  id          Int     @id() @default(autoincrement())
  title       String
  is_active   Boolean @default(true)
  description String?
  link        String?
  category_id Int?
  property_id Int?
  brand_id    Int?
  position    String
  sort_order  Int?
  image_id    Int
  image_sm_id Int?

  image    Attachment  @relation("Image", fields: [image_id], references: [id])
  image_sm Attachment? @relation("ImageSm", fields: [image_sm_id], references: [id])
  category Category?   @relation(fields: [category_id], references: [id])
  property Property?   @relation(fields: [property_id], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  @@map("banners")
}

// -------------------------------- CATEGORY -------------------------------- //
model Category {
  id                  Int     @id() @default(autoincrement())
  parent_id           Int?
  title               String  @db.VarChar
  key                 String? @unique @db.VarChar
  image_id            Int?    @unique
  sort_order          Int?    @db.SmallInt
  is_active           Boolean @default(true)
  path                String
  hex_color           String?
  is_feature_category Boolean @default(false)
  feature_title       String? //عنوان در صفحه اصلی

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? @db.Timestamp(6)

  parent   Category?   @relation("ParentChild", fields: [parent_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  children Category[]  @relation("ParentChild")
  image    Attachment? @relation(fields: [image_id], references: [id])
  banners  Banner[]

  @@map("categories")
}

// -------------------------------------------------------------------------- //
//                                  ADMIN END                                 //
// -------------------------------------------------------------------------- //

// ---------------------------------- USER ---------------------------------- //

// اگر کاربر در هر نقش نام و عکسش رو تغییر بده برای همه نقش ها اعمال میشه
model User {
  id                              Int       @id() @default(autoincrement())
  mobile_number                   String    @unique @db.VarChar(11)
  full_name                       String?   @db.VarChar
  profile_image_id                Int?      @unique
  // -------------------------------------------------------------------------- //
  owner_id                        Int?      @unique()
  advisor_id                      Int?      @unique()
  is_banned                       Boolean   @default(false)
  // -------------------------------------------------------------------------- //
  referral_code                   String?   @unique @db.VarChar()
  referrer_code                   String?   @db.VarChar()
  // -------------------------------------------------------------------------- //
  fcm_token                       String?
  jwt_level                       Int       @default(1)
  notification_read_at            DateTime  @default(now())
  // -------------------------------------------------------------------------- //
  contact_click_limit_exceeded_at DateTime?

  // -------------------------------------------------------------------------- //
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  // -------------------------------------------------------------------------- //
  profile_image Attachment? @relation(fields: [profile_image_id], references: [id])
  referrer      User?       @relation("UserReferrals", fields: [referrer_code], references: [referral_code])
  referrals     User[]      @relation("UserReferrals")
  owner         Owner?      @relation(fields: [owner_id], references: [id])
  advisor       Advisor?    @relation(fields: [advisor_id], references: [id])

  tickets           Ticket[]
  // payments         Payment[]
  // offer_codes      CustomerOfferCode[]
  turnovers         Turnover[]
  favorites         Favorite[]
  black_list        MessengerBlackList[]
  bookmarks         Bookmark[]
  call_logs         CallLog[]
  property_reports  PropertyReport[]
  property_reserves PropertyReserve[]

  @@map("users")
}

model Owner {
  id                 Int    @id() @default(autoincrement())
  national_code      String @db.VarChar(10) //چون دیتاهای جایاب قبلی کد ملی نداره مجبوریم از یکتایی دربیاریم و اونها رو ۱۱۱۱۱۱۱۱۱۱ بزاریم
  selfie_image_id    Int?   @unique
  status             Int    @db.SmallInt
  admin_descriptions Json[] @db.JsonB

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  selfie_image Attachment? @relation(fields: [selfie_image_id], references: [id])
  user         User?
  properties   Property[]

  @@map("owners")
}

model Advisor {
  id                          Int       @id() @default(autoincrement())
  national_code               String?   @unique @db.VarChar(10)
  //
  tel                         String?   @db.VarChar(11)
  area_code                   String?   @db.VarChar(3)
  //
  address                     String?   @db.Text
  cities                      City[]
  //
  is_special                  Boolean   @default(false)
  status                      Int       @db.SmallInt
  admin_descriptions          Json[]    @db.JsonB
  sort_order                  Int?
  subscription_expired_at     DateTime? @db.Date
  //
  users_satisfaction          Int?
  owners_satisfaction         Int?
  advisor_behavior            Int?
  advisor_responsibility      Int?
  response_speed_and_followup Int?
  //
  national_card_image_id      Int?      @unique
  document_image_id           Int?      @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  national_card_image    Attachment?            @relation("NationalCard", fields: [national_card_image_id], references: [id])
  document_image         Attachment?            @relation("DocumentImage", fields: [document_image_id], references: [id])
  user                   User?
  subscriptions          Subscription[]
  subscription_reminders SubscriptionReminder[]

  @@map("advisors")
}

model Rate {
  id                          Int  @id() @default(autoincrement())
  user_id                     Int
  advisor_id                  Int
  advisor_behavior            Int? @db.SmallInt
  advisor_responsibility      Int? @db.SmallInt
  response_speed_and_followup Int? @db.SmallInt

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  @@unique([user_id, advisor_id])
  @@map("rates")
}

// -------------------------------- PROPERTY -------------------------------- //
model Property {
  id                      Int       @id() @default(autoincrement())
  code                    String    @unique
  owner_id                Int
  title                   String?
  slug                    String?   @unique
  slug_hash               String?   @unique
  land_area               Int?
  building_area           Int?
  floors                  Int?
  unit_per_floor          Int?
  floor                   Int?
  construction_year       Int?
  region_id               Int?
  province_id             Int?
  city_id                 Int?
  address                 String?
  lat                     Float?
  lng                     Float?
  feature_image_id        Int?
  video_id                Int?
  is_chat_enabled         Boolean?
  is_location_visible     Boolean?
  has_pool                Boolean?
  std_capacity            Int?
  max_capacity            Int?
  canceling_type          String?
  advisor_commission      Int       @default(0) @db.SmallInt
  check_in_hour           String?
  check_out_hour          String?
  subscription_expired_at DateTime? @db.Date
  promoted_at             DateTime?
  sort_order              BigInt    @default(0) // timestamp - promote
  contact_type            Int       @default(1) @db.SmallInt
  status                  Int       @db.SmallInt
  admin_descriptions      Json[]    @db.JsonB
  is_authorized           Boolean   @default(false) @db.Boolean
  has_blue_tick           Boolean   @default(false) @db.Boolean
  options_array           Int[] //برای راحتی کوئری ارایه امکانات رو اینجا هم نگه میداریم
  favorite_count          Int       @default(0) @db.Integer

  // calendar_updated_at DateTime?
  // rate                Float?
  // rate_count               Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // -------------------------------------------------------------------------- //
  owner                  Owner                    @relation(fields: [owner_id], references: [id])
  property_options       OptionsOnProperty[]
  region                 City?                    @relation("PropertyRegion", fields: [region_id], references: [id])
  province               City?                    @relation("PropertyProvince", fields: [province_id], references: [id])
  city                   City?                    @relation("PropertyCity", fields: [city_id], references: [id])
  feature_image          Attachment?              @relation("FeatureImage", fields: [feature_image_id], references: [id])
  video                  Attachment?              @relation("Video", fields: [video_id], references: [id])
  attachments            Attachment[]             @relation("Property")
  temp_attachments       Attachment[]             @relation("Property_Temp")
  bedrooms               PropertyBedroom?
  daily_price            PropertyDailyPrice?
  assistants             PropertyOwnerAssistant[]
  description            PropertyDescription?
  property_authorize     PropertyAuthorize?
  banners                Banner[]
  // hourly_price          PropertyHourlyPrice?
  // monthly_price         PropertyMonthlyPrice?
  // yearly_price          PropertyYearlyPrice?
  subscriptions          Subscription[]
  payments               Payment[]
  chatrooms              MessengerChatroom[]
  calendar               PropertyCalendar[]
  blue_tick              PropertyBadge?
  favorites              Favorite[]
  bookmarks              Bookmark[]
  subscription_reminders SubscriptionReminder[]
  call_logs              CallLog[]
  reports                PropertyReport[]
  reserves               PropertyReserve[]

  @@index([id])
  @@index([code])
  @@index([has_pool])
  @@index([status])
  @@index([sort_order])
  @@index([advisor_commission])
  @@index([is_authorized])
  @@index([province_id])
  @@index([city_id])
  @@index([region_id])
  @@index([owner_id])
  @@map("properties")
}

model OptionsOnProperty {
  property_id Int
  option_id   Int
  assigned_at DateTime @default(now()) @db.Timestamp(6)

  property Property       @relation(fields: [property_id], references: [id])
  option   PropertyOption @relation(fields: [option_id], references: [id])

  @@id([property_id, option_id])
  @@map("options_on_property")
}

model PropertyDescription {
  id            Int     @id() @default(autoincrement())
  property_id   Int     @unique()
  property_dscr String?
  pattern_dscr  String?
  distance_dscr String?
  facility_dscr String?
  guest_dscr    String?
  pet_dscr      String?
  party_dscr    String?
  doc_dscr      String?
  other_dscr    String?
  ad_dscr       String?

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  property Property @relation(fields: [property_id], references: [id])

  @@map("property_descriptions")
}

model PropertyBedroom {
  id               Int   @id() @default(autoincrement())
  property_id      Int   @unique()
  bedrooms         Int[] //lenght of this field shawn bedrooms count
  additional_bed   Int
  master_room      Int
  sofa_bed         Int
  wc               Int?  @default(0)
  wc_ir            Int?  @default(0)
  bathroom_master  Int?  @default(0)
  bathroom_general Int?  @default(0)
  bathroom_in_wc   Int?  @default(0)
  bathroom_tub     Int?  @default(0)
  total_bedrooms   Int   @default(0)

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  property Property @relation(fields: [property_id], references: [id])

  @@map("property_bedrooms")
}

model PropertyDailyPrice {
  id                Int  @id() @default(autoincrement())
  property_id       Int  @unique()
  normal            Int
  wednesday         Int
  thursday          Int
  friday            Int
  peak              Int
  cleaning          Int? @default(0)
  additional_person Int
  today_offer       Int?

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  property Property @relation(fields: [property_id], references: [id])

  @@map("property_daily_prices")
}

model PropertyOwnerAssistant {
  id                      Int      @id() @default(autoincrement())
  property_id             Int
  is_owner                Boolean? @default(false)
  assistant_mobile_number String?  @db.VarChar(11)
  assistant_full_name     String?

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  property Property @relation(fields: [property_id], references: [id])

  @@map("property_owner_assistants")
}

model PropertyStatistics {
  id          Int      @id() @default(autoincrement())
  property_id Int
  view_count  Int      @default(0)
  date        DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([property_id, date])
  @@index([property_id, date])
  @@map("property_statistics")
}

// ---------------------------- PROPERTY OPTIONS ---------------------------- //
model PropertyOption {
  id          Int     @id() @default(autoincrement())
  title       String  @db.VarChar
  key         String? @db.VarChar(128)
  description String? @db.VarChar(256)
  group       String
  sort        Int?
  image_id    Int?

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt
  deleted_at DateTime? @db.Timestamp(6)

  properties OptionsOnProperty[]
  image      Attachment?         @relation(fields: [image_id], references: [id], onDelete: SetNull)

  @@map("property_options")
}

// -------------------------------- AUTHORIZE ------------------------------- //
model PropertyAuthorize {
  id          Int    @id() @default(autoincrement())
  property_id Int    @unique
  nc_image_id Int
  status      Int
  changelog   Json[] @db.JsonB

  //explicit many to many
  docs Attachment[] @relation("PropertyAuthDocsImage")

  property Property   @relation(fields: [property_id], references: [id])
  nc_image Attachment @relation("PropertyAuthNcImage", fields: [nc_image_id], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  @@map("property_authorize")
}

//---------------------------------- Calendar ---------------------------------//
model PropertyCalendar {
  id                  Int      @id() @default(autoincrement())
  property_id         Int
  day                 Int      @db.SmallInt
  month               Int      @db.SmallInt
  year                Int
  date                DateTime @db.Date
  note                String?  @db.VarChar
  is_reserved         Boolean  @default(false)
  price               Int?
  discounted_price    Int?
  discount_percentage Int      @default(0)
  effective_price     Int?
  advisor_commission  Int?     @db.SmallInt

  property Property @relation(fields: [property_id], references: [id])

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  @@unique([property_id, day, month, year])
  @@unique([property_id, date])
  @@index([property_id])
  @@index([date])
  @@index([day, month, year])
  @@map("property_calendar")
}

