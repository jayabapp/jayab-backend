// -------------------------------- FORM BUILDER -------------------------------- //
model FormBuilder {
  id           Int     @id() @default(autoincrement())
  title        String
  type         String
  content_id   Int?
  options      Json    @default("[]") @db.JsonB
  key          String?
  sort_order   Int?
  is_mandatory Boolean @default(true)
  description  String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  content Content? @relation(fields: [content_id], references: [id], onDelete: SetNull)

  @@map("form_builder")
}

model SubmittedForm {
  id            Int     @id() @default(autoincrement())
  content_id    Int?
  mobile_number String? @db.VarChar(11)
  full_name     String? @db.VarChar()
  ip            String? @db.VarChar()
  status        Int     @db.SmallInt

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  submitted_form_items SubmittedFormItems[]
  content              Content?             @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@map("submitted_forms")
}

model SubmittedFormItems {
  id                Int     @id() @default(autoincrement())
  submitted_form_id Int
  title             String
  value             String
  type              String?

  images Attachment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  submitted_from SubmittedForm @relation(fields: [submitted_form_id], references: [id], onDelete: Cascade)

  @@map("submitted_form_items")
}
