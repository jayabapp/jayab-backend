// -------------------------------------------------------------------------- //
//                                    CHAT                                    //
// -------------------------------------------------------------------------- //
model MessengerChatroom {
  id              Int    @id() @default(autoincrement())
  uuid            String @unique @default(uuid(7))
  property_id     Int?
  last_message_id Int?   @unique

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt

  participants MessengerParticipant[]
  messages     MessengerMessages[]
  last_message MessengerMessages?     @relation("LastMessage", fields: [last_message_id], references: [id])

  property Property? @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@index([uuid])
  @@index([created_at])
  @@index([property_id])
  @@map("messenger_chatrooms")
}

model MessengerParticipant {
  id Int @id() @default(autoincrement())

  chatroom_id        Int
  user_id            Int
  user_mobile_number String?
  role               String // customer, owner
  message_read_at    DateTime @default(now()) @db.Timestamp(6)

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt
  deleted_at DateTime? @db.Timestamp(6)

  chatroom MessengerChatroom   @relation(fields: [chatroom_id], references: [id], onDelete: Cascade)
  messages MessengerMessages[]

  @@unique([chatroom_id, user_id, role])
  @@index([chatroom_id])
  @@index([user_id])
  @@index([chatroom_id, user_id])
  @@map("messenger_participants")
}

model MessengerMessages {
  id             Int     @id() @default(autoincrement())
  chatroom_id    Int
  participant_id Int
  text           String?
  media_id       Int?
  third_party    String?

  chatroom              MessengerChatroom    @relation(fields: [chatroom_id], references: [id], onDelete: Cascade)
  participant           MessengerParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)
  chatroom_last_message MessengerChatroom?   @relation("LastMessage")
  media                 Attachment?          @relation(fields: [media_id], references: [id])

  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @updatedAt
  deleted_at DateTime? @db.Timestamp(6)

  @@index([created_at])
  @@index([chatroom_id, participant_id])
  @@index([chatroom_id])
  @@index([participant_id])
  @@map("messenger_messages")
}

view UnreadMessageCount {
  user_id      Int
  unread_count Int

  @@map("unread_message_counts")
}

