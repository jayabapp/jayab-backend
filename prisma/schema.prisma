  title               String?
  land_area           Int?
  building_area       Int?
  floors              Int?
  unit_per_floor      Int?
  floor               Int?
  construction_year   Int?
  region_id           Int?
  province_id         Int?
  city_id             Int?
  address             String?
  lat                 Float?
  lng                 Float?
  // feature_image_id    Int?
  // attachments         Attachment[]    @relation("Property")
  // temp_attachments    Attachment[]    @relation("Property_Temp")
